---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Fin from '../components/home/Fin.astro';
import IvyHead from '../components/guide/IvyHead.astro';
import IvyToc from '../components/guide/IvyToc.astro';
import { drawings } from '../drawings/generated';
import { renderGuide } from '../data/render-guide';
import '../styles/guide.css';
import '../styles/motion.css';

const entry = (await getEntry('guide', 'preparer-son-app'))!;
const { html, toc } = renderGuide(entry.body ?? '');
---
<Base title={entry.data.title} description={entry.data.description} defs>
  <section data-reveal="tete" class="wrap sec head">
    <ol class="crumbs fx" style="--d: 0s" aria-label="Fil d'Ariane"><li><a href="/">Accueil</a></li><li><span aria-current="page">Préparer son app</span></li></ol>
    <div class="ph">
      <svg class="ph-cornice" aria-hidden="true"><rect width="100%" height="8" fill="url(#gCorona)" /><rect width="100%" height="1" fill="#fff" /><rect y="7.4" width="100%" height="1" fill="#6F6657" opacity=".35" /><g transform="translate(0 8)"><rect width="100%" height="12" fill="#D3CCBF" /><rect width="100%" height="12" fill="url(#pDentil)" /></g><rect y="19" width="100%" height="1" fill="#6F6657" opacity=".4" /><rect width="100%" height="20" fill="#fff" filter="url(#fGrain)" opacity=".45" /></svg>
      <div class="ph-band">
        <svg class="tex" aria-hidden="true"><rect width="100%" height="100%" fill="#fff" filter="url(#fVeinsBig)" opacity=".45" /><rect width="100%" height="100%" fill="#fff" filter="url(#fGrain)" opacity=".5" /></svg>
        <svg width="16" height="16" viewBox="-6 -6 12 12" aria-hidden="true" class="ros" style="left: 24px;"><use href="#rosette" /></svg>
        <p class="eyebrow fx" style="--d: .1s;">Le guide</p>
        <h1 aria-label="Préparer son app"><span aria-hidden="true"><span class="bw" style="--i:0">Préparer</span> <span class="bw" style="--i:1">son</span> <span class="bw" style="--i:2">app</span></span></h1>
        <p class="ph-lead fx" style="--d: .9s;">{entry.data.description}</p>
        <svg width="16" height="16" viewBox="-6 -6 12 12" aria-hidden="true" class="ros" style="right: 24px;"><use href="#rosette" /></svg>
      </div>
      <svg class="z1" viewBox="0 0 1116 22" preserveAspectRatio="none" style="display: block; width: 100%; height: 22px;" aria-hidden="true"><rect x="4" y="0" width="1108" height="7.04" fill="#F3F0EA" /><rect x="6" y="7.04" width="1104" height="7.48" fill="#ECE7DF" /><rect x="8" y="14.52" width="1100" height="7.48" fill="#E3DDD2" /><path d="M4,.5 H1112" stroke="#fff" /><path d="M6,7.04 H1110 M8,14.52 H1108" stroke="#6F6657" stroke-opacity=".3" /><path d="M8,21.5 H1108" stroke="#6F6657" stroke-opacity=".45" /><rect x="4" y="0" width="1108" height="22" fill="#fff" filter="url(#fGrain)" opacity=".45" /></svg>
      <IvyHead />
    </div>
  </section>
  <div class="wrap guide">
    <aside data-reveal="toc" class="toc-d sec" aria-label="Sommaire">
      <svg class="crown" width="60" height="46" viewBox="0 0 60 46" aria-hidden="true" set:html={drawings.CROWN} />
      <nav class="toc toc-st">
        <svg class="tex" aria-hidden="true"><rect width="100%" height="100%" fill="#fff" filter="url(#fVeinsBig)" opacity=".45" /></svg>
        <p class="eyebrow">Sommaire</p>
        <ol>{toc.map((s) => <li><a href={`#${s.id}`}><span class:list={['tn', { dot: !s.n }]}>{s.n}</span><span>{s.label}</span></a></li>)}</ol>
      </nav>
      <IvyToc />
    </aside>
    <div class="prose">
      <details class="toc toc-m">
        <summary><span class="chev">›</span>Sommaire</summary>
        <nav aria-label="Sommaire"><ol>{toc.map((s) => <li><a href={`#${s.id}`}><span class:list={['tn', { dot: !s.n }]}>{s.n}</span><span>{s.label}</span></a></li>)}</ol></nav>
      </details>
      <Fragment set:html={html} />
    </div>
  </div>
  <Fin slot="footer" />
  <script src="../scripts/reveal.ts"></script>
  <script src="../scripts/scrollspy.ts"></script>
</Base>
