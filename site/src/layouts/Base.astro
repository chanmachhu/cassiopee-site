---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { drawings } from '../drawings/generated';
// defs: render the shared SVG defs (gradients, filters, symbols) and the marble texture; required by any drawing.
interface Props { title: string; description: string; defs?: boolean }
const { title, description, defs = false } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    {defs && (
      <>
        <svg width="0" height="0" style="position: absolute;" aria-hidden="true"><defs set:html={drawings.DEFS} /></svg>
        <svg class="tex" aria-hidden="true"><rect width="100%" height="100%" fill="#fff" filter="url(#fVeinsBig)" opacity=".4" /><rect width="100%" height="100%" fill="#fff" filter="url(#fGrain)" opacity=".25" /></svg>
      </>
    )}
    <Header />
    <main><slot /></main>
    <slot name="footer"><Footer /></slot>
  </body>
</html>
