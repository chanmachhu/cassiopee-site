---
import type { Exemple } from '../../data/exemples';
interface Props { exemple: Exemple; n: number }
const { exemple: e, n } = Astro.props;
---
<article class:list={['iso lift ex rv', n > 1 && `r${n}`]}>
  <svg class="sprig" width="84" height="22" viewBox="-42 -20 84 22" aria-hidden="true"><use href="#sprig" transform="scale(-1 1)" /><use href="#sprig" /></svg>
  <p class="tags">{e.tags}</p>
  <h3>{e.titre}</h3>
  <p>{e.resume}</p>
  <div class="btns">
    {e.enLigne && <a href={e.enLigne} class="btn-ivy">Voir en ligne</a>}
    <a href={e.code} class="btn-stone">Code</a>
    <a href={`/exemples#${e.slug}`} class="btn-stone">Recette</a>
  </div>
</article>
