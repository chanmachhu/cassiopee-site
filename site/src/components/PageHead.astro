---
import IvyHead from './guide/IvyHead.astro';
// Breadcrumb + cornice/frieze/steps head shared by the guide and examples pages; the h1 words blur in one by one.
interface Props { crumb: string; eyebrow: string; title: string; lead: string }
const { crumb, eyebrow, title, lead } = Astro.props;
---
<nav class="fx" style="--d: 0s" aria-label="Fil d'Ariane"><ol class="crumbs"><li><a href="/">Accueil</a></li><li><span aria-current="page">{crumb}</span></li></ol></nav>
<div class="ph">
  <svg class="ph-cornice" aria-hidden="true"><rect width="100%" height="8" fill="url(#gCorona)" /><rect width="100%" height="1" fill="#fff" /><rect y="7.4" width="100%" height="1" fill="#6F6657" opacity=".35" /><g transform="translate(0 8)"><rect width="100%" height="12" fill="#D3CCBF" /><rect width="100%" height="12" fill="url(#pDentil)" /></g><rect y="19" width="100%" height="1" fill="#6F6657" opacity=".4" /><rect width="100%" height="20" fill="#fff" filter="url(#fGrain)" opacity=".45" /></svg>
  <div class="ph-band">
    <svg class="tex" aria-hidden="true"><rect width="100%" height="100%" fill="#fff" filter="url(#fVeinsBig)" opacity=".45" /><rect width="100%" height="100%" fill="#fff" filter="url(#fGrain)" opacity=".5" /></svg>
    <svg width="16" height="16" viewBox="-6 -6 12 12" aria-hidden="true" class="ros" style="left: 24px;"><use href="#rosette" /></svg>
    <p class="eyebrow fx" style="--d: .1s;">{eyebrow}</p>
    <h1 aria-label={title}><span aria-hidden="true">{title.split(' ').map((w, i) => <Fragment>{i > 0 && ' '}<span class="bw" style={`--i:${i}`}>{w}</span></Fragment>)}</span></h1>
    <p class="ph-lead fx" style="--d: .9s;">{lead}</p>
    <svg width="16" height="16" viewBox="-6 -6 12 12" aria-hidden="true" class="ros" style="right: 24px;"><use href="#rosette" /></svg>
  </div>
  <svg class="z1" viewBox="0 0 1116 22" preserveAspectRatio="none" style="display: block; width: 100%; height: 22px;" aria-hidden="true"><rect x="4" y="0" width="1108" height="7.04" fill="#F3F0EA" /><rect x="6" y="7.04" width="1104" height="7.48" fill="#ECE7DF" /><rect x="8" y="14.52" width="1100" height="7.48" fill="#E3DDD2" /><path d="M4,.5 H1112" stroke="#fff" /><path d="M6,7.04 H1110 M8,14.52 H1108" stroke="#6F6657" stroke-opacity=".3" /><path d="M8,21.5 H1108" stroke="#6F6657" stroke-opacity=".45" /><rect x="4" y="0" width="1108" height="22" fill="#fff" filter="url(#fGrain)" opacity=".45" /></svg>
  <IvyHead />
</div>
